# ── Supabase ──────────────────────────────────────────────────────────────
# Get these from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Docker only — leave blank for Supabase cloud / Vercel
SUPABASE_INTERNAL_URL=

# ── Admin login ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@youryogastudio.com
ADMIN_PASSWORD=choose_a_strong_password

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# WhatsApp number with country code, no + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ── Razorpay (optional — can also be set via Admin → Settings UI) ─────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
